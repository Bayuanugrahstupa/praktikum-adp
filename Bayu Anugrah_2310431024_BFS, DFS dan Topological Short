        for tetangga in tetangga_list:
            edge = tuple(sorted([node, tetangga]))
            if edge not in edge_sudah_digambar:
                x2, y2 = posisi[tetangga]
                ax.plot([x1, x2], [y1, y2], color='gray', linewidth=1.5, zorder=1)
                edge_sudah_digambar.add(edge)

    # --- Siapkan warna tiap node berdasarkan urutan kunjungan ---
    urutan_index = {node: i for i, node in enumerate(urutan_kunjungan)}
    total = len(urutan_kunjungan)

    # --- Gambar lingkaran (node) satu per satu ---
    for node, (x, y) in posisi.items():
        if node == start_node:
            warna = '#e74c3c'  # merah untuk node awal
        elif node in urutan_index:
            # semakin belakang urutan kunjungan, semakin gelap birunya
            tingkat = 0.4 + 0.5 * (urutan_index[node] / max(total - 1, 1))
            warna = (0.15, 0.35, min(tingkat, 1.0))
        else:
            warna = '#bdc3c7'  # abu-abu jika belum dikunjungi

        lingkaran = plt.Circle((x, y), 0.35, color=warna, zorder=2, ec='black')
        ax.add_patch(lingkaran)
        ax.text(x, y, node, ha='center', va='center',
                 fontsize=13, fontweight='bold', color='white', zorder=3)

        # Nomor urutan kunjungan ditulis di atas node
        if node in urutan_index:
            ax.text(x, y + 0.55, str(urutan_index[node] + 1),
                     ha='center', va='center', fontsize=11,
                     fontweight='bold', color='darkred', zorder=3)

    ax.set_title(f"Visualisasi DFS (mulai dari node '{start_node}')\n"
                 f"Urutan kunjungan: {' -> '.join(urutan_kunjungan)}")
    ax.set_xlim(-1, 5)
    ax.set_ylim(-0.5, 5)
    ax.set_aspect('equal')
    ax.axis('off')
    plt.savefig("hasil_dfs.png", dpi=150, bbox_inches='tight')
    plt.show()


# ------------------------------------------
# 5. Menjalankan Program
# ------------------------------------------
if __name__ == "__main__":
    print("=== STRUKTUR GRAF ===")
    for node, neighbors in graph.items():
        print(f"{node} -> {neighbors}")
    print()

    start = 'A'  # Node awal DFS (bisa diganti sesuai kebutuhan)
    hasil = dfs(graph, start)

    print("\n=== HASIL AKHIR ===")
    print("Urutan kunjungan DFS:", ' -> '.join(hasil))

    # Tampilkan hasil dalam bentuk gambar graf
