# PROGRAM: DEPTH FIRST SEARCH (DFS)
# Mata Kuliah: Algoritma dan Pemrograman Graf
# ============================================
# Versi ini TIDAK menggunakan library networkx (auto-layout),
# posisi node ditentukan manual, dan gambar graf digambar
# sendiri menggunakan matplotlib biasa (garis + lingkaran).
# Library yang dipakai hanya matplotlib (standar untuk plotting).

import matplotlib.pyplot as plt

# ------------------------------------------
# 1. Representasi Graf (Adjacency List)
# ------------------------------------------
graph = {
    'A': ['B', 'C'],
    'B': ['A', 'D', 'E'],
    'C': ['A', 'F'],
    'D': ['B'],
    'E': ['B', 'F'],
    'F': ['C', 'E']
}

# ------------------------------------------
# 2. Posisi Node (ditentukan manual, bukan otomatis)
# ------------------------------------------
posisi = {
    'A': (2, 4),
    'B': (0, 2.5),
    'C': (4, 2.5),
    'D': (0, 0.5),
    'E': (2, 1),
    'F': (4, 0.5)
}

# ------------------------------------------
# 3. Fungsi DFS (rekursif)
# ------------------------------------------
def dfs(graph, node, visited=None, urutan_kunjungan=None):
    if visited is None:
        visited = set()
    if urutan_kunjungan is None:
        urutan_kunjungan = []

    visited.add(node)
    urutan_kunjungan.append(node)
    print(f"Mengunjungi node: {node}")

    for neighbor in graph[node]:
        if neighbor not in visited:
            print(f"  -> Menelusuri lebih dalam ke {neighbor}")
            dfs(graph, neighbor, visited, urutan_kunjungan)

    return urutan_kunjungan


# ------------------------------------------
# 4. Fungsi Gambar Graf (manual, tanpa networkx)
# ------------------------------------------
def gambar_graf(graph, posisi, urutan_kunjungan, start_node):
    fig, ax = plt.subplots(figsize=(7, 6))

    # --- Gambar semua garis edge terlebih dahulu ---
