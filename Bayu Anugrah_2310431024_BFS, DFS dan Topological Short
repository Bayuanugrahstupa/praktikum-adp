# ============================================
# PROGRAM: TOPOLOGICAL SORT
# Mata Kuliah: Algoritma dan Pemrograman Graf
# ============================================
# Program ini mendemonstrasikan algoritma Topological Sort
# pada graf berarah (directed graph) tanpa siklus (DAG),
# menggunakan pendekatan DFS, sekaligus menampilkan hasilnya
# dalam bentuk GAMBAR GRAF (visualisasi).

# Jika di Google Colab, jalankan dulu (cukup sekali):
# !pip install networkx matplotlib

import networkx as nx
import matplotlib.pyplot as plt

# ------------------------------------------
# 1. Representasi Graf Berarah (Adjacency List)
# ------------------------------------------
# Contoh kasus: urutan pengerjaan mata kuliah (prasyarat)
# A -> B artinya A harus dikerjakan/diselesaikan sebelum B

graph = {
    'A': ['B', 'C'],
    'B': ['D'],
    'C': ['D', 'F'],
    'D': ['E'],
    'E': [],
    'F': ['E']
}

# ------------------------------------------
# 2. Fungsi Topological Sort (DFS-based)
# ------------------------------------------
def topological_sort(graph):
    visited = set()
    stack = []  # menyimpan hasil urutan (dibalik di akhir)

    def dfs(node):
        visited.add(node)
        for neighbor in graph[node]:
            if neighbor not in visited:
                print(f"  -> Menelusuri {node} ke {neighbor}")
                dfs(neighbor)
        stack.append(node)  # node dimasukkan setelah semua tetangganya selesai
        print(f"Node selesai diproses: {node} (dimasukkan ke stack)")

    for node in graph:
        if node not in visited:
            print(f"\nMulai DFS dari node: {node}")
            dfs(node)

    stack.reverse()  # urutan topological = kebalikan urutan selesai
    return stack


# ------------------------------------------
# 3. Fungsi Visualisasi Graf (Gambar)
# ------------------------------------------
def gambar_graf(graph, urutan_topological):
    G = nx.DiGraph()  # graf BERARAH

    for node, neighbors in graph.items():
        G.add_node(node)
        for neighbor in neighbors:
            G.add_edge(node, neighbor)

    pos = nx.spring_layout(G, seed=42)

    plt.figure(figsize=(7, 6))

    # Gambar node & edge dasar
    nx.draw(
        G, pos,
        with_labels=True,
        node_color='lightgray',
        node_size=1200,
        font_size=12,
        font_weight='bold',
        edge_color='gray',
        arrows=True,
        arrowsize=20,
        arrowstyle='-|>'
    )

    # Warnai node sesuai urutan topological (gradasi hijau)
    colors = plt.cm.Greens(
        [i / len(urutan_topological) * 0.7 + 0.3 for i in range(len(urutan_topological))]
    )
    nx.draw_networkx_nodes(
        G, pos,
        nodelist=urutan_topological,
        node_color=colors,
        node_size=1200
    )

    # Tambahkan label nomor urutan topological di atas tiap node
    label_urutan = {node: str(i + 1) for i, node in enumerate(urutan_topological)}
    for node, label in label_urutan.items():
        x, y = pos[node]
        plt.text(x, y + 0.12, label, fontsize=11, color='darkgreen',
                  ha='center', fontweight='bold')

    plt.title(f"Visualisasi Topological Sort\n"
              f"Urutan: {' -> '.join(urutan_topological)}")
    plt.axis('off')
    plt.tight_layout()
    plt.savefig("hasil_topological_sort.png", dpi=150)
    plt.show()


# ------------------------------------------
# 4. Menjalankan Program
# ------------------------------------------
if __name__ == "__main__":
    print("=== STRUKTUR GRAF BERARAH (DAG) ===")
    for node, neighbors in graph.items():
        print(f"{node} -> {neighbors}")

    hasil = topological_sort(graph)

    print("\n=== HASIL AKHIR ===")
    print("Urutan Topological Sort:", ' -> '.join(hasil))

    # Tampilkan hasil dalam bentuk gambar graf
    gambar_graf(graph, hasil)
