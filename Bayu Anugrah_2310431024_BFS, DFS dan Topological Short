# ============================================
# PROGRAM: BREADTH FIRST SEARCH (BFS)
# Mata Kuliah: Algoritma dan Pemrograman Graf
# ============================================
# Program ini menjalankan algoritma BFS menggunakan queue,
# sekaligus menampilkan hasilnya dalam bentuk GAMBAR GRAF.
# Hanya menggunakan matplotlib (tidak ada library tambahan/AI).

from collections import deque
import matplotlib.pyplot as plt

# ------------------------------------------
# 1. Representasi Graf (Adjacency List)
# ------------------------------------------
graph = {
    'A': ['B', 'C'],
    'B': ['A', 'D', 'E'],
    'C': ['A', 'F'],
    'D': ['B'],
    'E': ['B', 'F'],
    'F': ['C', 'E']
}

# ------------------------------------------
# 2. Posisi Node (ditentukan manual)
# ------------------------------------------
posisi = {
    'A': (2, 4),
    'B': (0, 2.5),
    'C': (4, 2.5),
    'D': (0, 0.5),
    'E': (2, 1),
    'F': (4, 0.5)
}

# ------------------------------------------
# 3. Fungsi BFS
# ------------------------------------------
def bfs(graph, start_node):
    visited = set()
    queue = deque([start_node])
    visited.add(start_node)
    urutan_kunjungan = []

    print(f"Mulai BFS dari node: {start_node}\n")

    while queue:
        current_node = queue.popleft()
        urutan_kunjungan.append(current_node)
        print(f"Mengunjungi node: {current_node}")

        for neighbor in graph[current_node]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append(neighbor)
                print(f"  -> Menambahkan {neighbor} ke antrian")

    return urutan_kunjungan


# ------------------------------------------
# 4. Fungsi Gambar Graf (manual, tanpa networkx)
# ------------------------------------------
def gambar_graf(graph, posisi, urutan_kunjungan, start_node):
    fig, ax = plt.subplots(figsize=(7, 6))

    # --- Gambar semua garis edge terlebih dahulu ---
    edge_sudah_digambar = set()
    for node, tetangga_list in graph.items():
        x1, y1 = posisi[node]
        for tetangga in tetangga_list:
            edge = tuple(sorted([node, tetangga]))
            if edge not in edge_sudah_digambar:
                x2, y2 = posisi[tetangga]
                ax.plot([x1, x2], [y1, y2], color='gray', linewidth=1.5, zorder=1)
                edge_sudah_digambar.add(edge)

    # --- Siapkan warna tiap node berdasarkan urutan kunjungan ---
    urutan_index = {node: i for i, node in enumerate(urutan_kunjungan)}
    total = len(urutan_kunjungan)

    # --- Gambar lingkaran (node) satu per satu ---
    for node, (x, y) in posisi.items():
        if node == start_node:
            warna = '#e74c3c'  # merah untuk node awal
        elif node in urutan_index:
            # semakin belakang urutan kunjungan, semakin gelap hijaunya
            tingkat = 0.4 + 0.5 * (urutan_index[node] / max(total - 1, 1))
            warna = (0.15, min(tingkat, 1.0), 0.25)
        else:
            warna = '#bdc3c7'  # abu-abu jika belum dikunjungi

        lingkaran = plt.Circle((x, y), 0.35, color=warna, zorder=2, ec='black')
        ax.add_patch(lingkaran)
        ax.text(x, y, node, ha='center', va='center',
                 fontsize=13, fontweight='bold', color='white', zorder=3)

        # Nomor urutan kunjungan ditulis di atas node
        if node in urutan_index:
            ax.text(x, y + 0.55, str(urutan_index[node] + 1),
                     ha='center', va='center', fontsize=11,
                     fontweight='bold', color='darkgreen', zorder=3)

    ax.set_title(f"Visualisasi BFS (mulai dari node '{start_node}')\n"
                 f"Urutan kunjungan: {' -> '.join(urutan_kunjungan)}")
    ax.set_xlim(-1, 5)
    ax.set_ylim(-0.5, 5)
    ax.set_aspect('equal')
    ax.axis('off')
    plt.savefig("hasil_bfs.png", dpi=150, bbox_inches='tight')
    plt.show()


# ------------------------------------------
# 5. Menjalankan Program
# ------------------------------------------
if __name__ == "__main__":
    print("=== STRUKTUR GRAF ===")
    for node, neighbors in graph.items():
        print(f"{node} -> {neighbors}")
    print()

    start = 'A'  # Node awal BFS (bisa diganti sesuai kebutuhan)
    hasil = bfs(graph, start)

    print("\n=== HASIL AKHIR ===")
    print("Urutan kunjungan BFS:", ' -> '.join(hasil))

    # Tampilkan hasil dalam bentuk gambar graf
    gambar_graf(graph, posisi, hasil, start)


